# Optional root-only service on June's host. Review ingress before activation.
# The App key stays in place; do not give renewal credentials to exporters or Amp.
[Unit]
Description=June repository-scoped issue credential renewal
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/june-issues/credentials.json

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -I /opt/june-issues/credentials/current/issue_credentials.py
Restart=on-failure
RestartSec=15
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/june-issues /etc/june/github-app.pem
InaccessiblePaths=-/var/lib/june -/var/lib/june-debugshare -/var/lib/june-deploy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
