[Unit]
Description=June application slot %i (controller activated)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/june/slot.env
ConditionPathExists=/run/june-runtime/owner.lock

[Service]
Type=exec
User=june
Group=june
WorkingDirectory=/opt/june/slots/%i
Environment=HOME=/var/lib/june
Environment=PATH=/opt/node-v24.21.0/bin:/usr/bin:/bin
Environment=JUNE_CONFIG=/etc/june/config.json
Environment=JUNE_SLOT=%i
# Install with the existing app's exact secrets, namespace and persistent paths.
# Do not invent a fresh Rivet namespace or data directory during migration.
EnvironmentFile=/etc/june/slot.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/june-deploy/slot.py %i
ExecStop=/usr/bin/python3 -I -B /usr/local/lib/june-deploy/deploy.py --stop-app
Restart=no
KillMode=control-group
Delegate=no
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/june /run/june-runtime/owner.lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No Install section: only the controller/operator starts standby slots.
