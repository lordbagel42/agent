{
  "name": "@raygen/june",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "apps:start": "tsx src/apps/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ampcode/sdk": "0.1.0-20260918210405-g81edbf0",
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "0.128.0",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@openai/codex": "0.157.1",
    "@rivet-dev/dynamic-apps": "0.3.1",
    "ajv": "8.20.0",
    "cron-parser": "5.10.1",
    "hono": "4.13.9",
    "playwright": "1.63.0",
    "quickjs-emscripten": "0.32.0",
    "rivetkit": "2.3.21",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
