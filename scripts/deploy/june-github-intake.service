[Unit]
Description=June durable GitHub webhook intake
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/june/github-intake.json

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/june-github-intake/github_intake.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=june-github-intake
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/var/lib/june /etc/june/github-app.pem

[Install]
WantedBy=multi-user.target
