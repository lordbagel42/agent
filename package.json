{
  "name": "@raygen/june",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "apps:start": "node src/apps/supervisor.mjs",
    "artifacts:build": "tsx scripts/build-artifacts.ts",
    "debug:build": "pnpm --dir debug-site build && tsx scripts/build-debug-site.ts",
    "debug:start": "node dist/debug-site/server.mjs",
    "debug:preview": "tsx scripts/preview-debug-site.ts",
    "debug:check": "pnpm --dir debug-site check",
    "debug:format": "pnpm --dir debug-site format",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ampcode/sdk": "0.1.0-20260918210405-g81edbf0",
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "0.128.0",
    "@e2b/code-interpreter": "2.8.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@openai/codex": "0.157.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@rivet-dev/dynamic-apps": "0.3.1",
    "@rivetkit/engine-cli": "2.3.21",
    "@simplewebauthn/server": "14.0.3",
    "ajv": "8.20.0",
    "cron-parser": "5.10.1",
    "esbuild": "0.28.2",
    "hono": "4.13.9",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "playwright": "1.63.0",
    "quickjs-emscripten": "0.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rivetkit": "2.3.21",
    "tar-stream": "3.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/tar-stream": "3.1.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "optionalDependencies": {
    "@boxlite-ai/boxlite": "0.10.5"
  }
}
