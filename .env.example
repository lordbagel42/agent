# Copy to .env and supply credentials through your normal secret mechanism.
# Never commit .env or copy its contents into logs, chat, or memory.
JUNE_CONFIG=config.local.json
# Generate a random operator token of at least 32 characters.
JUNE_OPERATOR_TOKEN=
MODEL_API_KEY=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Optional owner-equivalent MCP access; see docs/agent-mcp.md before enabling.
# Storage key: 32 random bytes, standard base64. Token: 32 random bytes, base64url.
# Provision independently through your secret manager; never reuse operator auth.
# JUNE_AGENT_STORAGE_KEY=
# JUNE_AGENT_AMP_TOKEN=

# Native coding is off. Only opt in on an appropriately isolated host.
JUNE_ALLOW_NATIVE_CODING=0

# Retention, provider privacy, and history consent each need separate review.
# Configuration alone cannot enable these integrations.
JUNE_ALLOW_MEMORY=0
JUNE_ALLOW_MEMORY_MODELS=0
JUNE_ALLOW_HISTORY_IMPORTS=0

# Default: self-hosted loopback engine, local .data directory, Services disabled.
# RIVET_RUN_ENGINE_PORT=6420
# RIVETKIT_STORAGE_PATH=/absolute/persistent/june-data
# For an existing self-hosted engine instead of spawning a local one:
# RIVET_ENDPOINT=http://127.0.0.1:6420
# RIVET_TOKEN=use-your-secret-manager
# RIVET_NAMESPACE=default
# RIVET_POOL=default
