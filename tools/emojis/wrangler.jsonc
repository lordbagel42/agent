{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raygen-emojis",
  "account_id": "2fa4104b17af8808577f12883fa657b1",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "limits": { "cpu_ms": 30000 },
  "routes": [{ "pattern": "emojis.raygen.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raygen-emojis",
      "database_id": "d8935106-98f0-48ac-b7e1-24bb6509a912",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [{ "binding": "VECTORS", "index_name": "raygen-emojis" }],
  "ai": { "binding": "AI" },
  "secrets": {
    "required": [
      "READ_TOKEN",
      "INDEXER_TOKEN",
      "ADMIN_TOKEN",
      "SLACK_BOT_TOKEN",
      "SLACK_SIGNING_SECRET"
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false }
}
