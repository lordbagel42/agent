{
  "host": "127.0.0.1",
  "port": 3080,
  "owner": {
    "id": "owner",
    "identities": [
      {
        "channel": "slack",
        "accountId": "T_REPLACE_ME",
        "senderId": "U_REPLACE_ME"
      }
    ]
  },
  "model": {
    "protocol": "openai",
    "model": "YOUR_MODEL_ID",
    "apiKeyEnv": "MODEL_API_KEY"
  },
  "executionEnabled": true,
  "browserCompanion": {
    "enabled": false,
    "directory": "/var/lib/june-browser/ledger",
    "home": "/var/lib/june-browser/browser-home",
    "tempDirectory": "/var/lib/june-browser/tmp",
    "codexHome": "/var/lib/june-browser/codex",
    "navigationOrigins": ["https://example.com"],
    "resourceOrigins": ["https://example.com"],
    "processIsolationAcknowledged": true,
    "networkIsolationAcknowledged": true,
    "ephemeralStorageAcknowledged": true,
    "resourceLimitsAcknowledged": true
  },
  "emojiSearch": {
    "baseUrl": "https://emojis.raygen.dev",
    "timeoutMs": 4000
  },
  "activitySessions": {
    "enabled": false,
    "idleMs": 10800000
  },
  "slack": {
    "teamId": "T_REPLACE_ME",
    "botUserId": "U_BOT_REPLACE_ME",
    "signingSecretEnv": "SLACK_SIGNING_SECRET",
    "botTokenEnv": "SLACK_BOT_TOKEN",
    "contextEnabled": true,
    "participateInOwnerChannels": false
  },
  "coding": {
    "enabled": false,
    "workspaces": {},
    "timeoutMs": 3600000
  },
  "ampJobs": {
    "enabled": false,
    "host": "amp-execution.example.invalid",
    "user": "amp",
    "identityFile": "/etc/june-jobs/id_ed25519",
    "knownHostsFile": "/etc/june-jobs/known_hosts",
    "policyRevision": "ordinary-jobs-v1",
    "workspaces": {
      "amp-june": "/home/amp/workspaces/june-jobs"
    },
    "timeoutMs": 3600000
  }
}
